# LLM 模式一：直连 DeepSeek（pi 内置模型目录：deepseek-v4-flash / deepseek-v4-pro）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# LLM 模式二：中转站 / 任意 OpenAI 兼容端点（设置 LLM_BASE_URL 即启用，优先于直连）
LLM_BASE_URL=
LLM_API_KEY=

# Suno Provider：mock（本地合成演示）| sunoapi（sunoapi.org 第三方 API）
SUNO_PROVIDER=mock
SUNO_API_KEY=
SUNO_API_BASE=

# 本地 SQLite 路径
DB_PATH=./data/music-agent.db
